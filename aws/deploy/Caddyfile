# Caddy provisions and renews HTTPS automatically for this DNS name.
attendance.himon.in {
  encode gzip

  log {
    output file /var/log/caddy/college-attendance-access.log
    format json
  }

  route {
    handle /api/* {
      reverse_proxy 127.0.0.1:4000
    }

    handle {
      root * /var/www/college-attendance
      try_files {path} /index.html
      file_server
    }
  }
}
