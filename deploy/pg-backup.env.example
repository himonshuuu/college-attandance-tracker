R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Endpoint + bucket default to the "backup" bucket; override only if they change.
R2_ENDPOINT=https://c3d2312bbd50a8326f44802de3e3b2df.r2.cloudflarestorage.com
R2_BUCKET=backup
# Postgres connection string (same format as backend DATABASE_URL).
DATABASE_URL=
# Local staging dir + how many days of local copies to keep.
# Remote retention is handled by an R2 lifecycle rule (see pg-backup.sh header).
BACKUP_DIR=/var/backups/college-attendance
RETENTION_DAYS=7
